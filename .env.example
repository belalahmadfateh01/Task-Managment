DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_management
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password

# Generate a random secret with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE=1d
AUTH_COOKIE_SAME_SITE=lax

PORT=3001
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002
# Optional comma-separated IP/CIDR addresses of trusted reverse proxies.
TRUSTED_PROXIES=

# Used by npm run admin:create. Replace placeholders before creating the first administrator.
ADMIN_F_NAME=Admin
ADMIN_L_NAME=Account
ADMIN_USER_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-8-characters
